# Environment
NODE_ENV=development

# Server
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=falcon_eye

# Set to true when your PostgreSQL provider requires TLS.
DB_SSL=false

# Prefer migrations. Enable only for disposable local databases.
DB_SYNCHRONIZE=false

# Comma-separated browser origins allowed by the deployed API. "*" is refused in production.
ALLOWED_ORIGINS=http://localhost:5173

# true = public read-only demo: no writes, and the Jira / SonarCloud / GitHub routes are off.
# false = a private deployment with NO authentication: only ever run it behind an IP
# allow-list, VPN or SSO proxy. Production refuses to start unless this is true or false.
DEMO_MODE=false

# Optional backend logging level.
LOG_LEVEL=info

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
