# Environment
NODE_ENV=development

# Server
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=falcon_eye

# Set to true when your PostgreSQL provider requires TLS.
DB_SSL=false

# Prefer migrations. Enable only for disposable local databases.
DB_SYNCHRONIZE=false

# Comma-separated browser origins allowed by the deployed API.
ALLOWED_ORIGINS=http://localhost:5173

# Optional backend logging level.
LOG_LEVEL=info

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
